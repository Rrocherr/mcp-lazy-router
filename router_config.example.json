{
  "cache_path": ".mcp_lazy_cache.json",
  "spill_dir": ".mcp_lazy_spills",
  "cache_ttl_seconds": 86400,
  "policy": {
    "read_only": false,
    "require_confirmation_for_destructive": true,
    "strict_destructive_heuristics": true,
    "allowed_tools": [],
    "blocked_tools": [],
    "max_response_chars": 24000,
    "spill_oversized_responses": true
  },
  "servers": {
    "github": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "enabled": true,
      "timeout_seconds": 30.0,
      "idle_timeout_seconds": 300.0,
      "description": "GitHub repositories, issues, pull requests, and code search",
      "tags": ["git", "vcs", "issues", "pr"]
    },
    "remote-docs": {
      "transport": "http",
      "url": "${REMOTE_MCP_URL:-https://mcp.example.com/mcp}",
      "headers": {
        "Authorization": "Bearer ${REMOTE_MCP_TOKEN:-}"
      },
      "enabled": false,
      "read_only": true,
      "timeout_seconds": 25.0,
      "idle_timeout_seconds": 300.0,
      "description": "Remote Streamable HTTP documentation MCP server",
      "tags": ["docs", "search"]
    }
  }
}
